{
  "name": "proginone-go",
  "version": "0.0.0",
  "private": true,
  "description": "로컬에서 실행하는 AI 기반 개인 맞춤 Go 학습 플랫폼",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "node tools/content-cli/src/cli.ts check --dir content",
    "content:build": "node tools/content-cli/src/cli.ts build --dir content --out content/dist/content.db",
    "content:build:dev": "node tools/content-cli/src/cli.ts build --dir content --out content/dist/content.db --include-drafts",
    "build": "pnpm -r --if-present build",
    "check:deps": "depcruise packages tools --config .dependency-cruiser.cjs",
    "check:links": "node tools/check-links.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:deps && pnpm test && pnpm content:check && pnpm check:links"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
